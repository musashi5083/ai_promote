# Google Search Console MCP サーバー用の環境変数サンプル
# このファイルをコピーして .env を作成してください (.env は .gitignore 済み)。
#
#   cp .env.example .env

# サービスアカウントの JSON 鍵ファイルへの絶対パス。
# 未設定の場合は GOOGLE_APPLICATION_CREDENTIALS にフォールバックします。
GSC_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# 既定で参照する Search Console プロパティ。
# ドメインプロパティ: sc-domain:example.com
# URL プレフィックス : https://example.com/   (末尾のスラッシュまで一致させること)
# 各ツールの site_url 引数で個別に上書きできます。
GSC_SITE_URL=sc-domain:example.com
